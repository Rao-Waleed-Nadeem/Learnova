
FRONTEND_PORT=3000
BACKEND_PORT=8000

POSTGRES_DB=learnova
POSTGRES_USER=learnova
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

# In-Process Outbox Processor Configuration (Option B)
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5.0
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=5.0
OUTBOX_RETRY_MAX_SECONDS=300.0
OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=30.0
OUTBOX_ENABLE_ADVISORY_LOCK=true
